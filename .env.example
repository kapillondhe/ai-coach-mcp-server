MCP_HOST=0.0.0.0
MCP_PORT=8100
# MCP_AUTH_TOKEN=              # optional shared secret; unset = no auth (local dev)

# Tracing (mcp_server/telemetry.py) - unset PHOENIX_API_KEY disables tracing entirely
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_PROJECT_NAME=ai-coach
OTEL_SERVICE_NAME=ai-coach-mcp-server

# Knowledge-base vector search (mcp_server/rag/) - run `docker compose up -d` for local Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=               # required for Qdrant Cloud; unset for local/self-hosted Qdrant
QDRANT_COLLECTION=coaching_kb
